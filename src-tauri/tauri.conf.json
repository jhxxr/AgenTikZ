{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentTikZ",
  "version": "0.1.0",
  "identifier": "ai.agenttikz.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentTikZ — 科研级 TikZ 可视化编辑器 (BYOA / ACP)",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
