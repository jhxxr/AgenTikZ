{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgenTikZ",
  "version": "0.4.0",
  "identifier": "ai.agentikz.studio",
  "build": {
    "beforeDevCommand": "npm run adapters:stage && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run adapters:stage && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgenTikZ — 科研级 TikZ 可视化编辑器 (BYOA / ACP)",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "adapters/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
