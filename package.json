{
  "name": "agentikz",
  "private": true,
  "version": "0.5.0",
  "description": "AI-era Visual TikZ & PGFPlots Editor for Scientific Research with BYOA (ACP/MCP)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhxxr/AgenTikZ.git"
  },
  "homepage": "https://github.com/jhxxr/AgenTikZ#readme",
  "bugs": {
    "url": "https://github.com/jhxxr/AgenTikZ/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "adapters:stage": "node scripts/prepare-adapters.mjs",
    "adapters:verify": "node scripts/verify-adapters.mjs",
    "mcp:stage": "node scripts/prepare-mcp.mjs",
    "pi:stage": "node scripts/prepare-pi.mjs",
    "test:pi": "node --test runtime/pi/tests/*.mjs",
    "test:mcp": "node --test scripts/tests/mcp-integration.mjs",
    "test:packaging": "node --test scripts/tests/adapter-packaging.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "benchmark:parser": "node scripts/benchmark-parser.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@tauri-apps/api": "^2.2.0",
    "@uiw/react-codemirror": "^4.23.10",
    "katex": "^0.16.21",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tauri-apps/cli": "^2.2.0",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
